# =========================================================================
# 🛡️ 全局 Git 忽略規則 ( nursing home project master ignore list )
# =========================================================================

# 1. 忽略所有帳密與敏感設定檔 (絕對防禦機密外洩)
**/.env
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.pfx
**/credentials*
**/secrets*

# 2. 忽略所有大檔案權重模型與測試影片檔 (防爆 GitHub 100MB 限制與保護隱私)
*.pt
*.pth
*.onnx
*.onnx_data
*.mlpackage/
**/*.pt
**/*.pth
**/*.onnx
**/*.onnx_data
**/*.mlpackage/
temp_downloaded_model.*
Fall/temp_downloaded_model.*
*.mp4
*.avi
*.mov
*.mkv
**/*.mp4
**/*.avi
**/*.mov
**/*.mkv
Fall/test_demo/

# 3. 忽略 Python 與虛擬環境暫存
**/__pycache__/
**/.venv/
**/venv/
**/.pytest_cache/
*.pyc
*.pyo
*.pyd

# 4. 忽略系統日誌檔與臨時輸出
*.log
**/*.log
nohup.out
**/*.out
inference_system.log

# 5. 忽略作業系統垃圾檔案
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db

# 6. 忽略本地臨時數據集與快取
active_learning_dataset/
**/active_learning_dataset/
**/*.onnx.data
Fall/tools/.clearml-logs-final/
.clearml-logs-final/
**/active_learning_pose_dataset/
**/active_learning_split_dataset/
**/active_learning_pose_split_dataset/
**/label_studio_data/

# 7. 忽略後端靜態圖片暫存與本地數據庫、執行檔
backend/static/images/*.jpg
backend/*.db
go2rtc
go2rtc.zip
*.db

# 8. 忽略自動產生的 YOLO 訓練資料集 yaml（程式執行時動態寫入，不應進 Git）
Fall/tools/dynamic_data.yaml
Fall/tools/pose_dynamic_data.yaml

# 9. 忽略含本機絕對路徑的 data.yaml（請複製 data.yaml.example 並修改路徑）
Fall/tools/data.yaml
